// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  ADMIN
}

enum QuarterMonkeyRoomVisibility {
  PUBLIC
  PRIVATE
}

enum QuarterMonkeyRoomStatus {
  WAITING
  PLAYING
  FINISHED
}

enum QuarterMonkeyActionType {
  JOIN
  START
  ADD_CHAR
  SUSPECT
  COMPLETE_CHALLENGE
  FINISH_WORD
  ROUND_RESULT
  TIMEOUT
  REPLAY
  LEAVE
}

enum BlinkRoomVisibility {
  PUBLIC
  PRIVATE
}

enum BlinkRoomStatus {
  WAITING
  PLAYING
  FINISHED
}

enum BlinkPhase {
  ROLE_REVEAL
  BLINKING
  GUESSING
  ROUND_OVER
  FINISHED
}

enum BlinkActionType {
  JOIN
  START_ROUND
  REVEAL_ROLE
  READY
  GOT_WINKED
  MAKE_GUESS
  NEXT_ROUND
  REPLAY
  LEAVE
}

enum BekasaRoomVisibility {
  PUBLIC
  PRIVATE
}

enum BekasaRoomStatus {
  WAITING
  PLAYING
  FINISHED
}

enum BekasaPhase {
  ROLE_REVEAL
  MAIN_QUESTIONS
  BONUS_QUESTIONS
  VOTING
  REVEAL_VOTES
  BEKAS_GUESS
  ROUND_OVER
  FINISHED
}

enum BekasaActionType {
  JOIN
  START_ROUND
  REVEAL_ROLE
  READY
  ADVANCE_QUESTION
  BONUS_QUESTION
  SKIP_BONUS
  CAST_VOTE
  REVEAL_BEKAS
  BEKAS_GUESS
  NEXT_ROUND
  REPLAY
  LEAVE
}

enum DominoRoomVisibility {
  PUBLIC
  PRIVATE
}

enum DominoRoomStatus {
  WAITING
  PLAYING
  FINISHED
}

enum DominoGameMode {
  SOLO
  TEAMS
}

enum DominoTeam {
  TEAM_A
  TEAM_B
}

enum DominoPhase {
  PLAYING
  ROUND_OVER
  FINISHED
}

enum DominoActionType {
  JOIN
  START_ROUND
  PLAY_TILE
  DRAW_TILE
  PASS_TURN
  NEXT_ROUND
  REPLAY
  LEAVE
}

enum UnoRoomVisibility {
  PUBLIC
  PRIVATE
}

enum UnoRoomStatus {
  WAITING
  PLAYING
  FINISHED
}

enum UnoPhase {
  PLAYING
  ROUND_OVER
  FINISHED
}

enum UnoColor {
  RED
  BLUE
  GREEN
  YELLOW
  WILD
}

enum UnoActionType {
  JOIN
  START_ROUND
  PLAY_CARD
  DRAW_CARD
  PASS_TURN
  CALL_UNO
  CATCH_UNO
  NEXT_ROUND
  REPLAY
  LEAVE
}

enum ScrewRoomVisibility {
  PUBLIC
  PRIVATE
}

enum ScrewRoomStatus {
  WAITING
  PLAYING
  FINISHED
}

enum ScrewPhase {
  PEEKING
  PLAYING
  FINAL_TURNS
  ROUND_OVER
  FINISHED
}

enum ScrewActionType {
  JOIN
  START_ROUND
  DRAW_DECK
  DRAW_DISCARD
  REPLACE_SLOT
  DISCARD_DRAWN
  PEEK_SELF
  PEEK_OTHER
  SWAP_CARDS
  PING_PONG
  THE_THIEF
  SPY_ALL
  CALL_SCREW
  BASRA
  NEXT_ROUND
  REPLAY
  LEAVE
}

model User {
  id                        String                     @id @default(cuid())
  name                      String?
  email                     String                     @unique
  emailVerified             DateTime?
  image                     String?
  passwordHash              String?
  role                      UserRole                   @default(PLAYER)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  accounts                  Account[]
  sessions                  Session[]
  quarterMonkeyRoomPlayers  QuarterMonkeyRoomPlayer[]
  createdQuarterMonkeyRooms QuarterMonkeyRoom[]        @relation("QuarterMonkeyCreatedRooms")
  wonQuarterMonkeyRooms     QuarterMonkeyRoom[]        @relation("QuarterMonkeyWonRooms")
  blinkRoomPlayers          BlinkRoomPlayer[]
  createdBlinkRooms         BlinkRoom[]                @relation("BlinkCreatedRooms")
  wonBlinkRooms             BlinkRoom[]                @relation("BlinkWonRooms")
  bekasaRoomPlayers         BekasaRoomPlayer[]
  createdBekasaRooms        BekasaRoom[]               @relation("BekasaCreatedRooms")
  wonBekasaRooms            BekasaRoom[]               @relation("BekasaWonRooms")
  dominoRoomPlayers         DominoRoomPlayer[]
  createdDominoRooms        DominoRoom[]               @relation("DominoCreatedRooms")
  wonDominoRooms            DominoRoom[]               @relation("DominoWonRooms")
  unoRoomPlayers            UnoRoomPlayer[]
  createdUnoRooms           UnoRoom[]                  @relation("UnoCreatedRooms")
  wonUnoRooms               UnoRoom[]                  @relation("UnoWonRooms")
  screwRoomPlayers          ScrewRoomPlayer[]
  createdScrewRooms         ScrewRoom[]                @relation("ScrewCreatedRooms")
  wonScrewRooms             ScrewRoom[]                @relation("ScrewWonRooms")
  pingoRoomPlayers          PingoRoomPlayer[]
  createdPingoRooms         PingoRoom[]                @relation("PingoCreatedRooms")
  wonPingoRooms             PingoRoom[]                @relation("PingoWonRooms")
  autobusRoomPlayers        AutobusRoomPlayer[]
  createdAutobusRooms       AutobusRoom[]              @relation("AutobusCreatedRooms")
  wonAutobusRooms           AutobusRoom[]              @relation("AutobusWonRooms")
  estimationRoomPlayers     EstimationRoomPlayer[]
  createdEstimationRooms    EstimationRoom[]           @relation("EstimationCreatedRooms")
  wonEstimationRooms        EstimationRoom[]           @relation("EstimationWonRooms")
  sabahoRoomPlayers         SabahoRoomPlayer[]
  createdSabahoRooms        SabahoRoom[]               @relation("SabahoCreatedRooms")
  wonSabahoRooms            SabahoRoom[]               @relation("SabahoWonRooms")
  bankRoomPlayers           BankRoomPlayer[]
  createdBankRooms          BankRoom[]                 @relation("BankCreatedRooms")
  wonBankRooms              BankRoom[]                 @relation("BankWonRooms")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model QuarterMonkeyRoom {
  id                     String                      @id @default(cuid())
  roomCode               String                      @unique
  title                  String
  visibility             QuarterMonkeyRoomVisibility
  passwordHash           String?
  scoreLimit             Int                         @default(3)
  turnTimerSeconds       Int?                        @default(30)
  turnStartedAt          DateTime?                   @default(now())
  usedWords              String[]                    @default([])
  status                 QuarterMonkeyRoomStatus     @default(WAITING)
  currentWord            String                      @default("")
  currentTurnPlayerId    String?
  previousTurnPlayerId   String?
  challengeByPlayerId    String?
  challengeTargetPlayerId String?
  challengePrefix        String?
  createdById            String
  winnerId               String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  startedAt              DateTime?
  finishedAt             DateTime?
  createdBy              User                        @relation("QuarterMonkeyCreatedRooms", fields: [createdById], references: [id], onDelete: Cascade)
  winner                 User?                       @relation("QuarterMonkeyWonRooms", fields: [winnerId], references: [id], onDelete: SetNull)
  players                QuarterMonkeyRoomPlayer[]
  actions                QuarterMonkeyRoomAction[]
}

model QuarterMonkeyRoomPlayer {
  id           String                      @id @default(cuid())
  roomId       String
  userId       String
  displayName  String
  turnOrder    Int
  penaltyScore Int                         @default(0)
  isHost       Boolean                     @default(false)
  eliminatedAt DateTime?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  room         QuarterMonkeyRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions      QuarterMonkeyRoomAction[]   @relation("QuarterMonkeyActionActor")

  @@unique([roomId, userId])
  @@unique([roomId, turnOrder])
}

model QuarterMonkeyRoomAction {
  id         String                   @id @default(cuid())
  roomId     String
  actorId    String?
  type       QuarterMonkeyActionType
  value      String?
  success    Boolean?
  details    String?
  createdAt  DateTime                 @default(now())
  room       QuarterMonkeyRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor      QuarterMonkeyRoomPlayer? @relation("QuarterMonkeyActionActor", fields: [actorId], references: [id], onDelete: SetNull)
}

// ----------------------------------------------------
// Game 2: غمازة (Blink / Wink Murder)
// ----------------------------------------------------

model BlinkRoom {
  id                  String              @id @default(cuid())
  roomCode            String              @unique
  title               String
  visibility          BlinkRoomVisibility @default(PUBLIC)
  passwordHash        String?
  scoreLimit          Int                 @default(3) // Threshold points to win match
  status              BlinkRoomStatus     @default(WAITING)
  currentPhase        BlinkPhase          @default(ROLE_REVEAL)
  roundNumber         Int                 @default(1)
  blinkerPlayerId     String?             // Assigned Blinker player ID for this round
  survivorPlayerId    String?             // Last innocent player survivor who guesses
  guessTargetPlayerId String?             // Player guessed by survivor
  roundWinnerPlayerId String?             // Player who won this round
  roundResultSummary  String?             // Summary of round outcome
  createdById         String
  winnerId            String?             // Overall match winner (User ID)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  startedAt           DateTime?
  finishedAt          DateTime?
  createdBy           User                @relation("BlinkCreatedRooms", fields: [createdById], references: [id], onDelete: Cascade)
  winner              User?               @relation("BlinkWonRooms", fields: [winnerId], references: [id], onDelete: SetNull)
  players             BlinkRoomPlayer[]
  actions             BlinkRoomAction[]
}

model BlinkRoomPlayer {
  id           String            @id @default(cuid())
  roomId       String
  userId       String
  displayName  String
  score        Int               @default(0) // Points won
  isHost       Boolean           @default(false)
  isBlinker    Boolean           @default(false)
  roleRevealed Boolean           @default(false)
  isReady      Boolean           @default(false)
  isWinked     Boolean           @default(false)
  winkedAt     DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  room         BlinkRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions      BlinkRoomAction[] @relation("BlinkActionActor")

  @@unique([roomId, userId])
}

model BlinkRoomAction {
  id        String          @id @default(cuid())
  roomId    String
  actorId   String?
  type      BlinkActionType
  value     String?
  details   String?
  createdAt DateTime        @default(now())
  room      BlinkRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor     BlinkRoomPlayer? @relation("BlinkActionActor", fields: [actorId], references: [id], onDelete: SetNull)
}

// ----------------------------------------------------
// Game 3: بكاسة (Bekasa / Undercover / Impostor)
// ----------------------------------------------------

model BekasaRoom {
  id                    String               @id @default(cuid())
  roomCode              String               @unique
  title                 String
  visibility            BekasaRoomVisibility @default(PUBLIC)
  passwordHash          String?
  scoreLimit            Int                  @default(3) // Threshold points to win match
  status                BekasaRoomStatus     @default(WAITING)
  currentPhase          BekasaPhase          @default(ROLE_REVEAL)
  roundNumber           Int                  @default(1)
  categoryId            String               @default("football")
  categoryNameAr        String               @default("لاعبو كرة قدم")
  categoryNameEn        String               @default("Football Players")
  secretWordAr          String               @default("")
  secretWordEn          String               @default("")
  candidateWordsJson    String               @default("[]")
  bekasPlayerId         String?              // The assigned Bekas player ID for this round
  questionQueueJson     String               @default("[]") // Array of { askerId, targetId, done }
  currentQuestionIndex  Int                  @default(0)
  bonusQueueJson        String               @default("[]") // Array of { askerId, targetId, skipped, done }
  currentBonusIndex     Int                  @default(0)
  roundResultSummary    String?
  createdById           String
  winnerId              String?              // Overall match winner (User ID)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  startedAt             DateTime?
  finishedAt            DateTime?
  createdBy             User                 @relation("BekasaCreatedRooms", fields: [createdById], references: [id], onDelete: Cascade)
  winner                User?                @relation("BekasaWonRooms", fields: [winnerId], references: [id], onDelete: SetNull)
  players               BekasaRoomPlayer[]
  actions               BekasaRoomAction[]
}

model BekasaRoomPlayer {
  id                String             @id @default(cuid())
  roomId            String
  userId            String
  displayName       String
  score             Int                @default(0)
  isHost            Boolean            @default(false)
  isBekas           Boolean            @default(false)
  roleRevealed      Boolean            @default(false)
  isReady           Boolean            @default(false)
  votedPlayerId     String?
  bekasGuessedWord  String?
  bekasGuessCorrect Boolean?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  room              BekasaRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions           BekasaRoomAction[] @relation("BekasaActionActor")

  @@unique([roomId, userId])
}

model BekasaRoomAction {
  id        String           @id @default(cuid())
  roomId    String
  actorId   String?
  type      BekasaActionType
  value     String?
  details   String?
  createdAt DateTime         @default(now())
  room      BekasaRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor     BekasaRoomPlayer? @relation("BekasaActionActor", fields: [actorId], references: [id], onDelete: SetNull)
}

// ----------------------------------------------------
// Game 4: دومينو (Domino / Classic Draw & Block)
// ----------------------------------------------------

model DominoRoom {
  id                  String               @id @default(cuid())
  roomCode            String               @unique
  title               String
  visibility          DominoRoomVisibility @default(PUBLIC)
  passwordHash        String?
  scoreLimit          Int                  @default(100) // Threshold points to win match (e.g. 50, 100, 150)
  mode                DominoGameMode       @default(SOLO) // SOLO or TEAMS (2v2)
  status              DominoRoomStatus     @default(WAITING)
  currentPhase        DominoPhase          @default(PLAYING)
  roundNumber         Int                  @default(1)
  currentTurnPlayerId String?
  firstTurnPlayerId   String?
  leftEnd             Int?
  rightEnd            Int?
  boardTilesJson      String               @default("[]") // Array of { tile: [number, number], playedSide: "LEFT"|"RIGHT", reversed: boolean }
  boneyardJson        String               @default("[]") // Array of [number, number]
  consecutivePasses   Int                  @default(0)    // When all active players pass consecutively -> Blocked (قفلة)
  roundWinnerId       String?              // Player ID of round winner
  winningTeam         DominoTeam?          // If TEAMS mode
  roundResultSummary  String?
  createdById         String
  winnerId            String?              // Overall match winner (User ID)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  startedAt           DateTime?
  finishedAt          DateTime?
  createdBy           User                 @relation("DominoCreatedRooms", fields: [createdById], references: [id], onDelete: Cascade)
  winner              User?                @relation("DominoWonRooms", fields: [winnerId], references: [id], onDelete: SetNull)
  players             DominoRoomPlayer[]
  actions             DominoRoomAction[]
}

model DominoRoomPlayer {
  id           String             @id @default(cuid())
  roomId       String
  userId       String
  displayName  String
  seatIndex    Int                @default(0) // 0 to 3
  team         DominoTeam?        // TEAM_A or TEAM_B
  score        Int                @default(0) // Match points accumulated
  handJson     String             @default("[]") // Array of [number, number]
  tilesCount   Int                @default(0)
  isHost       Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  room         DominoRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions      DominoRoomAction[] @relation("DominoActionActor")

  @@unique([roomId, userId])
}

model DominoRoomAction {
  id        String           @id @default(cuid())
  roomId    String
  actorId   String?
  type      DominoActionType
  value     String?
  details   String?
  createdAt DateTime         @default(now())
  room      DominoRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor     DominoRoomPlayer? @relation("DominoActionActor", fields: [actorId], references: [id], onDelete: SetNull)
}

// ----------------------------------------------------
// Game 5: أونو (UNO Card Game)
// ----------------------------------------------------

model UnoRoom {
  id                    String            @id @default(cuid())
  roomCode              String            @unique
  title                 String
  visibility            UnoRoomVisibility @default(PUBLIC)
  passwordHash          String?
  scoreLimit            Int               @default(250) // Match points threshold to win
  status                UnoRoomStatus     @default(WAITING)
  currentPhase          UnoPhase          @default(PLAYING)
  roundNumber           Int               @default(1)
  currentTurnPlayerId   String?
  direction             Int               @default(1) // 1: clockwise, -1: counter-clockwise
  activeColor           UnoColor          @default(RED)
  topCardJson           String            @default("{}") // The card on top of discard pile
  drawDeckJson          String            @default("[]") // Remaining cards in draw pile
  discardPileJson       String            @default("[]") // Played cards history
  drawCardDrawnThisTurn Boolean           @default(false)
  roundWinnerId         String?
  roundResultSummary    String?
  createdById           String
  winnerId              String?           // Overall match champion (User ID)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  startedAt             DateTime?
  finishedAt            DateTime?
  createdBy             User              @relation("UnoCreatedRooms", fields: [createdById], references: [id], onDelete: Cascade)
  winner                User?             @relation("UnoWonRooms", fields: [winnerId], references: [id], onDelete: SetNull)
  players               UnoRoomPlayer[]
  actions               UnoRoomAction[]
}

model UnoRoomPlayer {
  id           String          @id @default(cuid())
  roomId       String
  userId       String
  displayName  String
  seatIndex    Int             @default(0) // 0 to 7
  score        Int             @default(0) // Accumulated points
  handJson     String          @default("[]") // UnoCard[]
  cardsCount   Int             @default(0)
  hasCalledUno Boolean         @default(false)
  isHost       Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  room         UnoRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions      UnoRoomAction[] @relation("UnoActionActor")

  @@unique([roomId, userId])
}

model UnoRoomAction {
  id        String         @id @default(cuid())
  roomId    String
  actorId   String?
  type      UnoActionType
  value     String?
  details   String?
  createdAt DateTime       @default(now())
  room      UnoRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor     UnoRoomPlayer? @relation("UnoActionActor", fields: [actorId], references: [id], onDelete: SetNull)
}

// ----------------------------------------------------
// Game 6: سكرو (Screw Card Game)
// ----------------------------------------------------

model ScrewRoom {
  id                  String              @id @default(cuid())
  roomCode            String              @unique
  title               String
  visibility          ScrewRoomVisibility @default(PUBLIC)
  passwordHash        String?
  mode                String              @default("SOLO") // "SOLO" or "TEAMS"
  cardsPerPlayer      Int                 @default(4) // 4 cards (2x2) or 6 cards (2x3)
  scoreLimit          Int                 @default(100) // 100, 150, 200 points match limit
  turnTimerSeconds    Int                 @default(30) // 0 (off), 15, 30, 45, 60 seconds
  turnStartedAt       DateTime?           // Timestamp when active turn started
  doubleFinalRound    Boolean             @default(false) // Double points near threshold
  screwPenaltyType    String              @default("PLUS_30") // "PLUS_30" or "DOUBLE_SCORE"
  status              ScrewRoomStatus     @default(WAITING)
  currentPhase        ScrewPhase          @default(PEEKING)
  roundNumber         Int                 @default(1)
  currentTurnPlayerId String?
  screwCallerId       String?             // Player who called "سكرو!"
  finalTurnsRemaining Int                 @default(0) // Remaining turns after screw is called
  drawDeckJson        String              @default("[]") // Remaining cards in deck
  discardPileJson     String              @default("[]") // Face-up discarded cards
  activeDrawnCardJson String?             // Card currently held in hand by turn player
  activeDrawnFrom     String?             // "DECK" or "DISCARD"
  pendingActionJson   String?             // Action waiting for player target selection
  roundWinnerId       String?
  roundResultSummary  String?
  createdById         String
  winnerId            String?             // Match winner User ID
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  startedAt           DateTime?
  finishedAt          DateTime?
  createdBy           User                @relation("ScrewCreatedRooms", fields: [createdById], references: [id], onDelete: Cascade)
  winner              User?               @relation("ScrewWonRooms", fields: [winnerId], references: [id], onDelete: SetNull)
  players             ScrewRoomPlayer[]
  actions             ScrewRoomAction[]
}

model ScrewRoomPlayer {
  id              String            @id @default(cuid())
  roomId          String
  userId          String
  displayName     String
  seatIndex       Int               @default(0)
  team            String?           // "TEAM_A" or "TEAM_B"
  score           Int               @default(0) // Accumulated points across rounds
  gridJson        String            @default("[]") // ScrewCardSlot[]: cards placed in player's grid
  initialPeekDone Boolean           @default(false)
  isHost          Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  room            ScrewRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions         ScrewRoomAction[] @relation("ScrewActionActor")

  @@unique([roomId, userId])
}

model ScrewRoomAction {
  id        String           @id @default(cuid())
  roomId    String
  actorId   String?
  type      ScrewActionType
  value     String?
  details   String?
  createdAt DateTime         @default(now())
  room      ScrewRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor     ScrewRoomPlayer? @relation("ScrewActionActor", fields: [actorId], references: [id], onDelete: SetNull)
}

enum PingoRoomVisibility {
  PUBLIC
  PRIVATE
}

enum PingoRoomStatus {
  WAITING
  PLAYING
  FINISHED
}

enum PingoPhase {
  SETUP
  PLAYING
  ROUND_OVER
  FINISHED
}

enum PingoActionType {
  JOIN
  START
  SETUP_CARD
  READY
  CALL_NUMBER
  SHOUT_PINGO
  NEXT_ROUND
  REPLAY
  LEAVE
}

model PingoRoom {
  id                  String              @id @default(cuid())
  roomCode            String              @unique
  title               String
  visibility          PingoRoomVisibility @default(PUBLIC)
  passwordHash        String?
  status              PingoRoomStatus     @default(WAITING)
  currentPhase        PingoPhase          @default(SETUP)
  scoreLimit          Int                 @default(3) // First to reach N round wins
  roundNumber         Int                 @default(1)
  currentTurnPlayerId String?
  turnStartedAt       DateTime?
  turnTimerSeconds    Int                 @default(30)
  calledNumbersJson   String              @default("[]") // Array of Ints e.g. [5, 12, 19]
  lastCalledNumber    Int?
  roundWinnerId       String?
  roundSummary        String?
  createdById         String
  winnerId            String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdBy           User                @relation("PingoCreatedRooms", fields: [createdById], references: [id], onDelete: Cascade)
  winner              User?               @relation("PingoWonRooms", fields: [winnerId], references: [id], onDelete: SetNull)
  players             PingoRoomPlayer[]
  actions             PingoRoomAction[]
}

model PingoRoomPlayer {
  id                  String            @id @default(cuid())
  roomId              String
  userId              String
  displayName         String
  seatIndex           Int               @default(0)
  score               Int               @default(0) // Total rounds won
  isReady             Boolean           @default(false)
  gridNumbersJson     String            @default("[]") // Array of 25 Ints (indices 0..24)
