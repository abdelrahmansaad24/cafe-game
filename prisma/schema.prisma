  actions       BankRoomAction[] @relation("BankActionActor")

  @@unique([roomId, userId])
}

model BankRoomAction {
  id        String          @id @default(cuid())
  roomId    String
  actorId   String?
  type      BankActionType
  value     String?
  details   String?
  createdAt DateTime        @default(now())
  room      BankRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
