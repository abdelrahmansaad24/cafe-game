DATABASE_URL="postgresql://username:password@host:5432/database?schema=public"

# Keep this at 5 or lower (hard-validated by app env schema).
DB_POOL_MAX="5"
DB_POOL_IDLE_TIMEOUT_MS="10000"
DB_POOL_CONNECTION_TIMEOUT_MS="5000"
GEMINI_MODEL="gemini-flash-latest"
GEMINI_API_KEY="replace-with-gemini-api-key"

# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-at-least-32-char-random-secret"

# Extra application secret used alongside Argon2 hashing.
AUTH_PEPPER="replace-with-at-least-16-char-random-pepper"

# Feature flags
ENABLE_GOOGLE_OAUTH="false"
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH="false"

# From Google Cloud Console OAuth 2.0 web application credentials.
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# go-wppserver (WhatsApp REST API)
WPPSERVER_URL="http://localhost:8786"
NEXTAUTH_URL="http://localhost:3000"
WPPSERVER_TOKEN=""
